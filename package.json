{
  "name": "sage-suite-public-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:simulation": "node scripts/generate-public-simulation.mjs",
    "generate:replay": "node scripts/render-public-replay.mjs",
    "check:simulation": "node scripts/generate-public-simulation.mjs --check",
    "check:replay": "node scripts/render-public-replay.mjs",
    "check:showcase-path": "node scripts/showcase-path-v4.mjs",
    "check:proprietary": "node scripts/scan-public-proprietary.mjs",
    "check:seo": "node scripts/verify-static-export.mjs",
    "verify": "npm run check:simulation && npm run check:showcase-path && npm run check:replay && npm run check:proprietary && npm run build && npm run check:seo"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "animejs": "4.5.0",
    "gsap": "^3.15.0",
    "motion": "^13.4.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
